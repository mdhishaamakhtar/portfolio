---
import { Font } from "astro:assets";
import "../styles/global.css";
import {
  DESCRIPTION,
  LINKS,
  OG_IMAGE,
  PERSON,
  SITE_URL,
  THEME_COLOR,
  TITLE,
} from "../consts";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** JSON-LD graphs for this page. */
  schemas?: unknown[];
}

const {
  title = TITLE,
  description = DESCRIPTION,
  noindex = false,
  schemas = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const ogImage = new URL(OG_IMAGE.path, Astro.site ?? SITE_URL).href;

// The direction contract travels in the built HTML so the render can be
// audited against it. It costs a few hundred bytes.
const contract = `
THESIS: Headings in serif, body in sans, on mint. Cormorant Garamond sets the name, the introduction and the names of things. Ysabeau, the sans its designer drew on the same Garamond skeleton, sets everything read at length. It refuses decoration for its own sake.
OWN-WORLD: Mint #e3fcec ground, brown names and headings, green links, near-black text. A rail on the left holds the portrait and each section's italic name; the content runs beside it on one axis, with dates, stacks and links in a notes column on the right.
STORY: Visitors learn who he is and what he does in one sentence, scan the work and projects by name, and email him.
FIRST VIEWPORT: A plain list of sections; beneath it the portrait in the rail and, beside it, the name set large, the bi rule, one plain sentence about what he does, and text links.
FORM: Three columns (rail, body, notes) that fold to one on a phone; owner asked for a redesign from scratch that keeps the colours.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PERSON.name} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-image-preview:large, max-snippet:-1"
      }
    />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="me" href={LINKS.github} />
    <link rel="me" href={LINKS.linkedin} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={PERSON.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta property="profile:first_name" content={PERSON.givenName} />
    <meta property="profile:last_name" content={PERSON.familyName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />

    <Font
      cssVariable="--font-cormorant"
      preload={[
        { subset: "latin", weight: 500, style: "normal" },
        { subset: "latin", weight: 600, style: "normal" },
      ]}
    />
    <Font
      cssVariable="--font-ysabeau"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font cssVariable="--font-ysabeau-italic" />
    <Font cssVariable="--font-nastaliq" preload />

    {schemas.map((schema) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    ))}
  </head>
  <body>
    <Fragment set:html={`<!--${contract}-->`} />
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <div class="page">
      <slot />
    </div>
  </body>
</html>

<style>
  .page {
    max-width: calc(76rem + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--page-top) var(--gutter) clamp(2.5rem, 6vw, 4rem);
  }
</style>
