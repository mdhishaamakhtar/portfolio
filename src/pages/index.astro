---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Colophon from "../components/Colophon.astro";
import LinkedText from "../components/LinkedText.astro";
import portrait from "../assets/portrait.png";
import { LINKS, PERSON, SITE_URL } from "../consts";
import {
  community,
  credentials,
  credo,
  education,
  hero,
  projects,
  recognition,
  research,
  work,
  writing,
} from "../data/profile";
import { profileGraph } from "../lib/schema";

const portraitUrl = new URL("/portrait.jpg", SITE_URL).href;

const links = [
  { label: "Résumé", href: LINKS.resume },
  { label: "GitHub", href: LINKS.github, me: true },
  { label: "LinkedIn", href: LINKS.linkedin, me: true },
  { label: "Email", href: LINKS.email },
];

const span = (start: string, end: string) =>
  start === end ? start : `${start} – ${end}`;

// Titles are plain brown text; links are always green. A job without its own
// links points at the company by its domain.
const jobLinks = (job: (typeof work)[number]) =>
  job.links ?? [{ label: new URL(job.href).hostname, href: job.href }];

// What each project link reads as, and how a screen reader names it.
const projectLinks: Record<string, { text: string; name: string }> = {
  Live: { text: "Website", name: "website" },
  Design: { text: "Design", name: "design document" },
  Code: { text: "Code", name: "source code" },
};
---

<Base schemas={[profileGraph(portraitUrl)]}>
  <header class="intro">
    <h1 class="name">{PERSON.name}</h1>
    <p class="pride">
      <span class="bi" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span>Bi, and proud of it.</span>
    </p>
    <p class="lede">{hero.lede}</p>
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href} rel={link.me ? "me noopener" : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <Image
      src={portrait}
      alt={`${PERSON.givenName} laughing, in glasses and a denim shirt, in warm afternoon light`}
      widths={[240, 360, 480]}
      sizes="(min-width: 34rem) 11.5rem, 6.5rem"
      loading="eager"
      fetchpriority="high"
      class="portrait"
    />
  </header>

  <main id="main">
    <Section id="about" title="About">
      <p>
        {credo.lead} <em class="quote">{credo.quote}</em>
      </p>
      {credo.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>{credo.close}</p>
    </Section>

    <Section id="work" title="Work">
      <div class="stack">
        {work.map((job) => (
          <article class="item">
            <div class="item-head">
              <h3 class="item-title">
                {job.company}
                {job.urdu && (
                  <span lang="ur" dir="rtl" class="urdu">
                    {job.urdu}
                  </span>
                )}
              </h3>
              <p class="item-links">
                {jobLinks(job).map((link) => (
                  <a href={link.href} rel="noopener">
                    {link.label}
                  </a>
                ))}
              </p>
            </div>
            <ul class="roles">
              {job.roles.map((role) => (
                <li>
                  <span>{role.title}</span>
                  <span class="when">{span(role.start, role.end)}</span>
                </li>
              ))}
            </ul>
            <p>
              <LinkedText text={job.summary} link={job.mention} />
            </p>
            {job.highlights.length > 0 && (
              <ul class="points">
                {job.highlights.map((point) => (
                  <li>
                    {typeof point === "string" ? (
                      point
                    ) : (
                      <LinkedText text={point.text} link={point.link} />
                    )}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </Section>

    <Section id="projects" title="Projects">
      <ul class="stack">
        {projects.map((project) => (
          <li class="item">
            <div class="item-head">
              <h3 class="item-title">{project.name}</h3>
              <p class="item-links">
                {project.links.map((link) => (
                  <a
                    href={link.href}
                    rel="noopener"
                    aria-label={`${project.name} ${projectLinks[link.label].name}`}
                  >
                    {projectLinks[link.label].text}
                  </a>
                ))}
              </p>
            </div>
            <p class="tagline">{project.tagline}</p>
            <p>{project.description}</p>
            <p class="when">{project.stack.join(", ")}</p>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="research" title="Research">
      <article class="item">
        <div class="item-head">
          <h3 class="item-title">{research.title}</h3>
          <p class="item-links">
            <a href={research.arxiv.href} rel="noopener">
              arXiv
            </a>
          </p>
        </div>
        <p class="when credits">
          <span>With Sharanya Mukherjee and Dr.&nbsp;R.&nbsp;Kannadasan</span>
          <span>
            {research.venue}, {research.arxiv.id}
          </span>
        </p>
        <p>{research.summary}</p>
      </article>
    </Section>

    <Section id="writing" title="Writing">
      <ul class="list">
        {writing.map((article) => (
          <li>
            <a href={article.href} rel="noopener">
              {article.title}
            </a>
            <span>
              {article.note} <span class="when">{article.where}</span>
            </span>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="elsewhere" title="Elsewhere">
      <ul class="list">
        {recognition.map((item) => (
          <li>
            <span class="strong">{item.title}</span>
            <span>{item.detail}</span>
          </li>
        ))}
        <li>
          <span class="strong">
            <a href={community.href} rel="noopener">
              {community.title}
            </a>
          </span>
          <span>{community.detail}</span>
          <span class="when">{community.when}</span>
        </li>
      </ul>
    </Section>

    <Section id="education" title="Education">
      <ul class="list">
        <li>
          <span class="strong">{education.school}</span>
          <span class="when">
            {education.degree}, {education.year} · {education.grade}
          </span>
        </li>
        {credentials.map((item) => (
          <li>
            {item.href ? (
              <a href={item.href} rel="noopener">
                {item.title}
              </a>
            ) : (
              item.title
            )}
            <span class="when">{item.detail}</span>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="contact" title="Contact">
      <div class="contact">
        <p>
          Email is the best way to reach me. I’m always happy to talk about
          backend systems, Urdu, or something you’re building for the people who
          usually get left out.
        </p>
        <p class="email">
          <a href={LINKS.email}>{PERSON.email}</a>
        </p>
      </div>
    </Section>
  </main>

  <Colophon />
</Base>

<style>
  /* The name is set to the measure: one line, exactly as wide as the
     column beneath it, at every screen size. Everything else on the page
     is quiet so this can be the one large thing. */
  .intro {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name name"
      "pride pride"
      "lede photo"
      "links links";
    column-gap: 1.25rem;
    align-items: center;
  }

  .name {
    grid-area: name;
    /* The name is 7.79em wide at this weight and tracking, so dividing
       the column by a touch more fills the line with a hair to spare. */
    font-size: calc(100cqi / 7.8);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--brown);
  }

  .pride {
    grid-area: pride;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
    font-style: italic;
    color: var(--quiet);
  }

  .bi {
    display: grid;
    gap: 2px;
    width: 3.5rem;
  }

  .bi i {
    display: block;
    height: 2px;
  }

  .bi i:nth-child(1) {
    background: var(--bi-1);
  }
  .bi i:nth-child(2) {
    background: var(--bi-2);
  }
  .bi i:nth-child(3) {
    background: var(--bi-3);
  }

  .lede {
    grid-area: lede;
    margin-top: 1.5rem;
    font-size: clamp(1.3125rem, 2.8vw, 1.75rem);
    line-height: 1.35;
  }

  .links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1rem;
  }

  .links a {
    display: inline-block;
    padding-block: 0.5rem;
  }

  .portrait {
    grid-area: photo;
    margin-top: 1.5rem;
    width: 6.5rem;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 0.5rem;
    box-shadow:
      0 0 0 1px rgb(127 85 57 / 0.14),
      0 18px 30px -18px rgb(84 56 38 / 0.55);
  }

  /* Anything wider than a phone: the photo stands beside everything under
     the name. Its top meets the bi rule's line and its bottom meets the
     links, with the introduction centred in between. */
  @media (min-width: 34rem) {
    .intro {
      grid-template-areas:
        "name name"
        "pride photo"
        "lede photo"
        "links photo";
      grid-template-rows: auto auto 1fr auto;
      column-gap: 2.5rem;
    }

    .pride {
      margin-top: 1.5rem;
    }

    .lede {
      margin-top: 0;
      max-width: 30ch;
    }

    .links {
      margin-top: 0;
    }

    .links a {
      padding-bottom: 0;
    }

    .portrait {
      align-self: start;
      margin-top: 1.5rem;
      width: clamp(8.5rem, 18vw, 11.5rem);
    }
  }

  main :global(p + p) {
    margin-top: 0.875rem;
  }

  .quote {
    color: var(--brown);
  }

  .stack {
    display: grid;
    gap: clamp(1.75rem, 4.5vw, 2.5rem);
    list-style: none;
    padding: 0;
  }

  .item > * + * {
    margin-top: 0.375rem;
  }

  .item-title {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    line-height: 1.25;
    font-weight: 600;
    color: var(--brown);
  }

  .urdu {
    margin-left: 0.5rem;
    font-size: 0.85em;
    font-weight: 400;
  }

  .tagline {
    font-style: italic;
    color: var(--ink);
  }

  .roles {
    list-style: none;
    padding: 0;
  }

  .roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .when {
    font-style: italic;
    color: var(--quiet);
  }

  /* Who it was with, then where it appeared, each on its own line. */
  .credits {
    display: grid;
  }

  /* A short, fine dash in brown: lighter than a disc, closer to the
     weight of Cormorant's strokes. */
  .points {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .points li {
    position: relative;
    padding-left: 1.5rem;
  }

  .points li::before {
    content: "";
    position: absolute;
    left: 0.125rem;
    top: 0.82em;
    width: 0.625rem;
    height: 1px;
    background: var(--brown);
  }

  /* With room in the margin, the dashes hang outside the column, so every
     line of text on the page starts at the same edge. */
  @media (min-width: 48rem) {
    .points li {
      padding-left: 0;
    }

    .points li::before {
      left: -1.375rem;
    }
  }

  /* The title on the left and its links on the right, above the dates, so
     the right edge always holds the details. */
  .item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.125rem 1.5rem;
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
  }

  /* A taller hit area for thumbs, without moving the line. */
  .item-links a {
    padding-block: 0.5rem;
    margin-block: -0.5rem;
  }

  .list {
    display: grid;
    gap: 1.125rem;
    list-style: none;
    padding: 0;
  }

  .list li {
    display: grid;
    line-height: 1.4;
  }

  .strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* The page opens with the name set large and closes with the address
     set large: the one thing to do after reading. It shrinks to stay on
     one line on a phone. */
  .contact {
    container-type: inline-size;
  }

  .email {
    margin-top: 1.25rem;
    font-size: min(2.25rem, 100cqi / 15.5);
    line-height: 1.2;
    white-space: nowrap;
  }
</style>
