---
import Base from "../layouts/Base.astro";
import Colophon from "../components/Colophon.astro";
import { PERSON } from "../consts";
---

<Base
  title={`Page not found · ${PERSON.name}`}
  description="This page doesn’t exist. Head back to the start of hishaam.dev."
  noindex
>
  <p class="home">{PERSON.name}</p>
  <main id="main" class="missing">
    <h1>This page isn’t here.</h1>
    <p>
      The link may be old, or the address may have a typo. Everything I’ve put
      online is linked from the first page.
    </p>
    <p>
      <a href="/">Back to the start</a>
    </p>
  </main>
  <Colophon />
</Base>

<style>
  .home {
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 600;
    color: var(--brown);
  }

  .missing {
    display: grid;
    gap: 1rem;
    max-width: var(--measure);
    padding-block: clamp(3rem, 12vw, 7rem) 0;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1.05;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--brown);
  }
</style>
