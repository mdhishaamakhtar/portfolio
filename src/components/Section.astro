---
/**
 * A section: its name stacked above the content. The content keeps to a
 * reading measure, so lines stay comfortable on wide screens.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} class="section" aria-labelledby={headingId}>
  <h2 id={headingId} class="title">
    {title}
  </h2>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-top: clamp(3.25rem, 8vw, 4.75rem);
  }

  /* A clear step above the entry titles, with a hairline so a new
     section reads as one while scrolling. */
  .title {
    margin-bottom: 1.25rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--hairline);
    font-size: clamp(1.75rem, 4.5vw, 2.25rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--brown);
  }

  .content {
    max-width: var(--measure);
  }
</style>
