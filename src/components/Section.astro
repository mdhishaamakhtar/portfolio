---
/**
 * A section: a rule across the page, its name in the rail on the left and
 * its content beside it. The name stays in view while its section scrolls
 * past. On a small screen the name sits above the content.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  class="section frame"
  aria-labelledby={headingId}
  tabindex="-1"
>
  <h2 id={headingId} class="title serif">
    {title}
  </h2>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .section {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  /* A section takes focus when the list at the top jumps to it, so the
     next Tab continues from here. It is not a control, so it shows no
     ring. */
  .section:focus {
    outline: none;
  }

  .title {
    margin-bottom: 1.5rem;
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.125rem);
    line-height: 1.1;
    font-style: italic;
    color: var(--brown);
  }

  @media (min-width: 62rem) {
    .title {
      position: sticky;
      top: calc(var(--bar) + 1.25rem);
      align-self: start;
      margin-bottom: 0;
    }

    /* The content's first line sits on the section name's baseline. */
    .content {
      padding-top: 0.25rem;
    }
  }
</style>
