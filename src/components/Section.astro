---
/**
 * A section: its name stacked above the content. The content keeps to a
 * reading measure, so lines stay comfortable on wide screens.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} class="section" aria-labelledby={headingId}>
  <h2 id={headingId} class="title">
    {title}
  </h2>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-top: clamp(3.5rem, 9vw, 5.5rem);
  }

  /* Italic, so a section's name is a different voice from the upright
     entry titles beneath it as well as a step larger, with a hairline so
     a new section reads as one while scrolling. */
  .title {
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--hairline);
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    line-height: 1.1;
    font-weight: 500;
    font-style: italic;
    color: var(--brown);
  }

  .content {
    max-width: var(--measure);
  }
</style>
