---
/**
 * A section: its name stacked above the content. The content keeps to a
 * reading measure, so lines stay comfortable on wide screens.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} class="section" aria-labelledby={headingId}>
  <h2 id={headingId} class="title">
    {title}
  </h2>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .title {
    margin-bottom: 0.875rem;
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    line-height: 1.3;
    font-weight: 600;
    color: var(--brown);
  }

  .content {
    max-width: var(--measure);
  }
</style>
