---
import { PERSON } from "../consts";

const year = new Date().getFullYear();
---

<footer class="colophon">
  <p>
    © {year}
    {PERSON.name}. Set in Cormorant Garamond.
    <a href="https://github.com/mdhishaamakhtar/portfolio">Source on GitHub</a>.
  </p>
  <p>
    The opinions here are mine, not those of any employer, past, present or
    future.
  </p>
</footer>

<style>
  .colophon {
    display: grid;
    gap: 0.375rem;
    margin-top: clamp(4rem, 10vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    font-size: 1rem;
    font-style: italic;
    color: var(--quiet);
  }
</style>
